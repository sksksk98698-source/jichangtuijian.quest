---
import { SITE } from "../config/site";

const year = new Date().getFullYear();

function socialLabel(url: string): string {
  if (url.includes("instagram")) return "Instagram";
  if (url.includes("facebook")) return "Facebook";
  if (url.includes("linkedin")) return "LinkedIn";
  if (url.includes("tiktok")) return "TikTok";
  if (url.includes("t.me") || url.includes("telegram")) return "Telegram";
  if (url.includes("twitter") || url.includes("x.com")) return "X";
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}

const validSocials = (SITE.business.socialProfiles || []).filter(
  (url) => Boolean(url) && !url.includes("example.com")
);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{SITE.name}</p>
      {SITE.business.address?.city && (
        <p class="footer-text">
          {SITE.business.address.street && <>{SITE.business.address.street}<br /></>}
          {SITE.business.address.postalCode} {SITE.business.address.city}
        </p>
      )}
      <p class="footer-text">
        {SITE.business.phone && (
          <><a href={`tel:${SITE.business.phone}`}>{SITE.business.phone}</a><br /></>
        )}
        {SITE.business.email && (
          <a href={`mailto:${SITE.business.email}`}>{SITE.business.email}</a>
        )}
      </p>
    </div>

    <div>
      <p class="footer-col-title">TOPIC CLUSTERS 专题矩阵</p>
      <nav class="footer-topic-links">
        <a href="/recommend/">42家机场推荐天梯榜 (万字深度)</a>
        <a href="/free-nodes/">免费节点与公益订阅现状白皮书</a>
        <a href="/free-trial/">免费试用与1元测试真实清单</a>
        <a href="/risk-warning/">机场跑路预警与资金盘黑名单</a>
        <a href="/faq/">科学网络加速百问权威排障百科</a>
        <a href="/guide/">选型避坑全景指南 (万字专著)</a>
      </nav>
    </div>

    <div>
      <p class="footer-col-title">核心资产与快速直达</p>
      <nav class="footer-topic-links">
        <a href="/brand/guangsu/">全站首推标杆：光速云 (8折码 AMM)</a>
        <a href="/brand/">全部 42 家机场品牌库</a>
        <a href="/clients/">全平台客户端下载中心</a>
        <a href="/#speedtest">17 家重点品牌晚高峰测速图</a>
      </nav>
    </div>

    <nav class="footer-nav" aria-label="Footer links">
      <p class="footer-col-title">网站政策与条款</p>
      <a href="/legal-notice/">{SITE.ui.legalNoticeLabel}</a>
      <a href="/privacy-policy/">{SITE.ui.privacyPolicyLabel}</a>
      {
        validSocials.map((url) => (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {socialLabel(url)}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container">
    <p class="footer-copyright">
      &copy; {year} {SITE.name} — {SITE.ui.allRightsReserved}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding-block: var(--space-4) var(--space-3);
    border-top: 1px solid rgba(247, 240, 228, 0.1);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .footer-text,
  .footer-text a {
    color: var(--color-dark-text-muted);
    font-size: var(--text-sm);
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent-bright);
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .footer-topic-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-topic-links a {
    color: var(--color-dark-text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-topic-links a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer-nav a {
    color: var(--color-dark-text-muted);
    font-size: var(--text-sm);
  }

  .footer-nav a:hover,
  .footer-text a:hover {
    color: var(--color-accent-bright);
  }

  .footer-copyright {
    font-size: var(--text-sm);
    opacity: 0.55;
    margin: 0;
  }
</style>
