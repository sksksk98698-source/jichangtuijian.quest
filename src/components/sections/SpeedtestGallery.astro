---
import { BRANDS } from "../../data/brands";

const testedBrands = BRANDS.filter((b) => Boolean(b.speedtestImage));
---

<section id="speedtest" class="section section-alt speedtest-gallery-section">
  <div class="container">
    <div class="gallery-header">
      <p class="section-eyebrow">LABORATORY EVIDENCE</p>
      <h2>实验室高精度测速实测图谱</h2>
      <p class="gallery-intro">
        所有测速图均来自自动化测试探针与真实抓包记录（MAI-TEST-BOT / Speedtest.net），涵盖晚高峰时段香港、日本、新加坡、美国核心节点的实测延迟与下行带宽。
      </p>
    </div>

    <div class="speedtest-grid">
      {testedBrands.map((brand) => (
        <div class="speedtest-tile">
          <div class="tile-header">
            <span class="tile-rank">#{brand.rank}</span>
            <h4 class="tile-name">{brand.name}</h4>
            <span class="tile-line">{brand.lineType}</span>
          </div>

          <a href={`/brand/${brand.slug}/#speedtest`} class="tile-img-link">
            <img
              src={brand.speedtestImage}
              alt={`${brand.name} 测速实测图`}
              loading="lazy"
              class="tile-img"
            />
            <span class="tile-hover-overlay">查看 {brand.name} 完整评测报告 →</span>
          </a>

          <div class="tile-footer">
            <span class="tile-summary">{brand.speedtestSummary}</span>
            <a href={`/brand/${brand.slug}/`} class="tile-btn">详评</a>
          </div>
        </div>
      ))}
    </div>

    <div class="gallery-more-bar">
      <p>目前已收录并公开全部 17 份重点品牌晚高峰高精度实测制图</p>
      <a href="/brand/" class="button button-secondary">
        查看 42 家完整品牌库与选型指南 →
      </a>
    </div>
  </div>
</section>

<style>
  .speedtest-gallery-section {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-header {
    max-width: 760px;
    margin-bottom: var(--space-4);
  }

  .gallery-intro {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .speedtest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-3);
  }

  .speedtest-tile {
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: var(--radius);
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition), border-color var(--transition);
  }

  .speedtest-tile:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
  }

  .tile-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .tile-rank {
    background: #38bdf8;
    color: #0f172a;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .tile-name {
    margin: 0;
    font-size: 1.05rem;
    color: #f8fafc;
  }

  .tile-line {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-left: auto;
  }

  .tile-img-link {
    position: relative;
    display: block;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
  }

  .tile-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: opacity var(--transition);
  }

  .tile-hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    font-size: 0.88rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity var(--transition);
    padding: 10px;
    text-align: center;
  }

  .tile-img-link:hover .tile-hover-overlay {
    opacity: 1;
  }

  .tile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #1e293b;
    min-height: 32px;
  }

  .tile-summary {
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile-btn {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .gallery-more-bar {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .gallery-more-bar p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }
</style>
