---
import { BRANDS, FEATURED_BRAND } from "../../data/brands";
import BrandCard from "../BrandCard.astro";

const gsy = FEATURED_BRAND;
const allOtherBrands = BRANDS.filter((b) => b.slug !== gsy.slug);
---

<section id="featured-airport" class="section featured-airport-section">
  <div class="container">
    <!-- 主推头条大卡片 -->
    <div class="spotlight-card">
      <div class="spotlight-badge-row">
        <span class="spotlight-pill">🏆 2026 全站评测综合第一名</span>
        <span class="spotlight-sub-pill">{gsy.since} · {gsy.lineType}</span>
      </div>

      <div class="spotlight-body">
        <div class="spotlight-info">
          <h2>{gsy.name} <span class="spotlight-en">({gsy.englishName})</span></h2>
          <p class="spotlight-desc">{gsy.intro}</p>

          <div class="spotlight-highlights-list">
            {gsy.features.map((feat) => (
              <div class="spotlight-feat-item">
                <span class="chk">✓</span>
                <span>{feat}</span>
              </div>
            ))}
          </div>

          <div class="spotlight-pricing-strip">
            <div class="strip-item">
              <span class="strip-label">入门年付折算</span>
              <span class="strip-val highlight">{gsy.minPriceMonthly}</span>
            </div>
            <div class="strip-item">
              <span class="strip-label">特色套餐</span>
              <span class="strip-val">¥147 永久247GB 不过期</span>
            </div>
            <div class="strip-item">
              <span class="strip-label">专属优惠券</span>
              <span class="strip-val coupon-code"><code>{gsy.coupon}</code></span>
            </div>
          </div>

          <div class="spotlight-actions">
            <a
              href={gsy.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="button button-spotlight-aff"
            >
              直达光速云官网开通 ↗
            </a>
            <a href={`/brand/${gsy.slug}/`} class="button button-secondary">
              查看光速云深度评测报告
            </a>
          </div>
        </div>

        <div class="spotlight-chart-wrap">
          <div class="chart-box-header">
            <span class="obs-tag">LAB VERIFIED</span>
            <span class="obs-title-s">光速云 晚高峰测速实录</span>
          </div>
          <a href={`/brand/${gsy.slug}/#speedtest`} class="chart-link-overlay">
            <img
              src={gsy.speedtestImage}
              alt="光速云 节点测速实测"
              class="spotlight-speedtest-img"
              loading="lazy"
            />
            <span class="zoom-hint">🔍 点击查看完整测速分析</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 首页全景展示全部 42 家机场品牌 -->
    <div class="top-ranking-header">
      <div>
        <p class="section-eyebrow">COMPLETE 42 BRANDS DIRECTORY</p>
        <h2>42 家机场品牌全景推荐榜单</h2>
        <p class="ranking-sub-desc">已收录并核验全部 42 家主流与新锐网络加速服务商，按综合评级与网络规格统一呈现。</p>
      </div>
      <a href="/brand/" class="view-all-link">前往品牌库高级筛选 ({BRANDS.length}家) →</a>
    </div>

    <div class="top-picks-grid">
      {allOtherBrands.map((brand) => (
        <BrandCard brand={brand} />
      ))}
    </div>
  </div>
</section>

<style>
  .featured-airport-section {
    padding-top: var(--space-4);
  }

  .spotlight-card {
    background: linear-gradient(135deg, #2b1e12 0%, #1d140d 100%);
    color: #fff;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-lift);
    margin-bottom: var(--space-section);
  }

  .spotlight-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-3);
  }

  .spotlight-pill {
    background: var(--gradient-accent);
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-glow);
  }

  .spotlight-sub-pill {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-dark-text-muted);
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .spotlight-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-4);
    align-items: center;
  }

  .spotlight-info h2 {
    font-size: 2.2rem;
    color: #fff;
    margin: 0 0 8px;
  }

  .spotlight-en {
    font-size: 1.1rem;
    color: var(--color-dark-text-muted);
    font-weight: normal;
  }

  .spotlight-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-dark-text-muted);
    margin-bottom: var(--space-3);
  }

  .spotlight-highlights-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--space-3);
  }

  .spotlight-feat-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9rem;
    color: #f1f5f9;
  }

  .chk {
    color: #10b981;
    font-weight: 800;
  }

  .spotlight-pricing-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    padding: 10px;
    margin-bottom: var(--space-3);
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .strip-label {
    font-size: 0.72rem;
    color: var(--color-dark-text-muted);
  }

  .strip-val {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .strip-val.highlight {
    color: var(--color-accent-bright);
  }

  .coupon-code code {
    background: #f59e0b;
    color: #000;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 800;
  }

  .spotlight-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .button-spotlight-aff {
    background: var(--gradient-accent);
    color: #fff;
    padding: 0.75rem 1.4rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: var(--shadow-glow);
  }

  .spotlight-chart-wrap {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: var(--radius-sm);
    padding: 12px;
  }

  .chart-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .obs-tag {
    background: #10b981;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .obs-title-s {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .chart-link-overlay {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 6px;
  }

  .spotlight-speedtest-img {
    width: 100%;
    max-height: 280px;
    object-fit: contain;
    background: #000;
    transition: transform var(--transition);
  }

  .chart-link-overlay:hover .spotlight-speedtest-img {
    transform: scale(1.02);
  }

  .zoom-hint {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .top-ranking-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-3);
  }

  .top-picks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: var(--space-3);
  }

  .view-all-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .spotlight-body {
      grid-template-columns: 1fr;
    }
  }
</style>
