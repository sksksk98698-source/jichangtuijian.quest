---
import type { BrandEntity } from "../data/brands";

interface Props {
  brand: BrandEntity;
  featured?: boolean;
}

const { brand, featured = false } = Astro.props;

const isMeasured = brand.dataStatus === "measured";
const statusText = isMeasured ? "实验室实测" : "官方档案";
const statusClass = isMeasured ? "badge-measured" : "badge-vendor";
---

<article
  class={`brand-card card ${featured ? "brand-card-featured" : ""}`}
  data-slug={brand.slug}
  data-tags={brand.tags.join(",")}
>
  <!-- 卡片头部：排名、名称、英文名、状态 -->
  <div class="card-header">
    <div class="header-left">
      <div class="rank-badge">#{brand.rank}</div>
      <div class="brand-headings">
        <div class="brand-title-line">
          <h3 class="brand-name">
            <a href={`/brand/${brand.slug}/`}>{brand.name}</a>
          </h3>
          {brand.englishName && <span class="brand-en">({brand.englishName})</span>}
        </div>
        <p class="brand-meta">{brand.since} · {brand.lineType}</p>
      </div>
    </div>
    <span class={`status-badge ${statusClass}`}>{statusText}</span>
  </div>

  <!-- 品牌简要描述 -->
  <p class="brand-intro" title={brand.intro}>{brand.intro}</p>

  <!-- 核心指标仪表板 -->
  <div class="brand-metrics">
    <div class="metric-col">
      <span class="m-label">入门价格</span>
      <span class="m-val highlight" title={brand.minPriceMonthly}>{brand.minPriceMonthly}</span>
    </div>
    <div class="metric-col">
      <span class="m-label">主要协议</span>
      <span class="m-val" title={brand.protocols.slice(0, 2).join(" / ")}>
        {brand.protocols.slice(0, 2).join(" / ")}
      </span>
    </div>
    <div class="metric-col">
      <span class="m-label">流媒体 & AI</span>
      <span class="m-val text-green">支持主流解锁</span>
    </div>
  </div>

  <!-- 特征标签 -->
  <div class="brand-tags">
    {brand.tags.slice(0, 4).map((tag) => (
      <span class="tag-chip">{tag}</span>
    ))}
    {brand.speedtestImage && <span class="tag-chip tag-speedtest">⚡ 附实测图</span>}
  </div>

  <!-- 底部固定对齐操作区 -->
  <div class="card-footer">
    <div class="card-actions">
      <a
        href={brand.affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="btn-action btn-aff"
      >
        官网注册直达 ↗
      </a>
      <a href={`/brand/${brand.slug}/`} class="btn-action btn-detail">
        深度评测报告
      </a>
    </div>

    <!-- 专属优惠码条（统一高度，保证所有卡片严格平齐） -->
    {brand.coupon ? (
      <div class="coupon-bar">
        <span>专属优惠码：</span>
        <code>{brand.coupon}</code>
      </div>
    ) : (
      <div class="coupon-bar coupon-bar-empty">
        <span>无需优惠码 · 官网直享特惠</span>
      </div>
    )}
  </div>
</article>

<style>
  .brand-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    min-height: 380px;
  }

  .brand-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: var(--color-accent);
  }

  .brand-card-featured {
    border: 2px solid var(--color-accent);
    background: linear-gradient(180deg, #fffcf7 0%, #ffffff 100%);
  }

  /* 头部区域 */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 12px;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .rank-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-dark-bg);
    color: var(--color-accent-bright);
    font-weight: 800;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .brand-headings {
    min-width: 0;
    flex: 1;
  }

  .brand-title-line {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .brand-name {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
  }

  .brand-name a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition);
  }

  .brand-name a:hover {
    color: var(--color-accent);
  }

  .brand-en {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: normal;
    white-space: nowrap;
  }

  .brand-meta {
    margin: 3px 0 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status-badge {
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge-measured {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .badge-vendor {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }

  /* 描述文本 */
  .brand-intro {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.55;
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.8em;
  }

  /* 指标面板：3 列安全自适应，杜绝文字挤压截断 */
  .brand-metrics {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr 1.1fr;
    gap: 6px;
    padding: 8px 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    margin-bottom: 12px;
    overflow: hidden;
  }

  .metric-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .m-label {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .m-val {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .m-val.highlight {
    color: var(--color-accent);
  }

  .m-val.text-green {
    color: #059669;
  }

  /* 标签 */
  .brand-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
    min-height: 48px;
    align-content: flex-start;
  }

  .tag-chip {
    padding: 2px 7px;
    font-size: 0.72rem;
    background: #f1e7d3;
    color: #5c4327;
    border-radius: 4px;
    white-space: nowrap;
  }

  .tag-speedtest {
    background: #e0f2fe;
    color: #0369a1;
    font-weight: 600;
  }

  /* 底部固定对齐包装 */
  .card-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  /* 按钮区：固定平直胶囊，杜绝换行挤压成球形 */
  .card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
  }

  .btn-action {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 8px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    white-space: nowrap;
    transition: all var(--transition);
    box-sizing: border-box;
  }

  .btn-aff {
    background: var(--gradient-accent);
    color: #ffffff !important;
    border: none;
    box-shadow: 0 4px 12px rgba(146, 64, 14, 0.25);
  }

  .btn-aff:hover {
    filter: brightness(1.12);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(146, 64, 14, 0.35);
  }

  .btn-detail {
    background: transparent;
    color: var(--color-accent) !important;
    border: 1.5px solid var(--color-accent);
  }

  .btn-detail:hover {
    background: var(--color-accent);
    color: #ffffff !important;
    transform: translateY(-2px);
  }

  /* 优惠码条：统一定高 32px，保证所有卡片绝对齐平 */
  .coupon-bar {
    height: 32px;
    padding: 0 10px;
    background: #fffbeb;
    border: 1px dashed #fde68a;
    border-radius: 6px;
    font-size: 0.78rem;
    color: #92400e;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .coupon-bar code {
    background: #fef3c7;
    padding: 1px 6px;
    border-radius: 3px;
    font-weight: 700;
    font-size: 0.82rem;
    color: #92400e;
  }

  .coupon-bar-empty {
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    color: #64748b;
    font-size: 0.75rem;
  }
</style>
