---
// Sticky dark header with a subtle blur: business name + navigation.
// Supports multi-level dropdowns with pure CSS hover on desktop,
// and accessible mobile accordion expansion.
import { SITE } from "../config/site";
import { FEATURED_BRAND } from "../data/brands";
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a href="/" class="brand">
        <span class="brand-text">{SITE.name}</span>
        <span class="brand-sub">SEO / GEO 矩阵</span>
      </a>
    </div>

    <button
      id="menu-burger"
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label={SITE.ui.menuOpenLabel}
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="main-menu" class="nav">
      {SITE.navigation.map((item) => (
        item.children ? (
          <div class="nav-item-dropdown">
            <a href={item.href} class="nav-link dropdown-toggle">
              {item.label}
              <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="dropdown-menu">
              <div class="dropdown-inner">
                {item.children.map((sub) => (
                  <a href={sub.href} class="dropdown-item">
                    <span class="dropdown-title">{sub.label}</span>
                    <span class="dropdown-desc">{sub.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class="nav-link">{item.label}</a>
        )
      ))}

      <!-- 头部右侧首推 CTA 胶囊 -->
      <a
        href={FEATURED_BRAND.affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="header-featured-cta"
      >
        <span class="cta-pulse"></span>
        <span>首推光速云 8折码 AMM ↗</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-dark-bg) 94%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(247, 240, 228, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 72px;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.1;
  }

  .brand-text {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-dark-text);
    letter-spacing: 0.02em;
    transition: color var(--transition);
  }

  .brand:hover .brand-text {
    color: var(--color-accent-bright);
  }

  .brand-sub {
    font-size: 0.68rem;
    color: var(--color-accent-bright);
    letter-spacing: 0.08em;
    font-weight: 700;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    color: var(--color-dark-text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 6px;
    transition: all var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* 下拉菜单 */
  .nav-item-dropdown {
    position: relative;
  }

  .dropdown-arrow {
    transition: transform var(--transition);
    opacity: 0.7;
  }

  .nav-item-dropdown:hover .dropdown-arrow {
    transform: rotate(180deg);
    opacity: 1;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 290px;
    background: #1e150f;
    border: 1px solid rgba(247, 240, 228, 0.18);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .nav-item-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: background var(--transition);
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .dropdown-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-dark-text);
  }

  .dropdown-item:hover .dropdown-title {
    color: var(--color-accent-bright);
  }

  .dropdown-desc {
    font-size: 0.75rem;
    color: var(--color-dark-text-muted);
    margin-top: 2px;
    line-height: 1.35;
  }

  /* 头部主推 CTA 胶囊 */
  .header-featured-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--gradient-accent);
    color: #fff !important;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    margin-left: 8px;
    box-shadow: 0 2px 10px rgba(146, 64, 14, 0.35);
    transition: all var(--transition);
    white-space: nowrap;
  }

  .header-featured-cta:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(146, 64, 14, 0.5);
  }

  .cta-pulse {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.7; }
  }

  /* 汉堡按钮 */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: var(--space-1);
    cursor: pointer;
  }

  .burger span {
    width: 24px;
    height: 2.5px;
    background: var(--color-dark-text);
    border-radius: 2px;
  }

  @media (max-width: 990px) {
    .burger {
      display: flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #1a120c;
      border-bottom: 1px solid rgba(247, 240, 228, 0.15);
      padding: 12px 16px 20px;
      max-height: calc(100vh - 72px);
      overflow-y: auto;
    }

    .nav.open {
      display: flex;
    }

    .nav-item-dropdown {
      width: 100%;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      background: rgba(0, 0, 0, 0.2);
      margin: 4px 0 8px 12px;
      padding: 4px;
      pointer-events: auto;
    }

    .header-featured-cta {
      margin: 12px 0 0;
      justify-content: center;
      padding: 10px;
    }
  }
</style>

<script>
  const burger = document.getElementById("menu-burger");
  const menu = document.getElementById("main-menu");

  burger?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(Boolean(open)));
  });

  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A" && !(e.target as HTMLElement).classList.contains("dropdown-toggle")) {
      menu.classList.remove("open");
      burger?.setAttribute("aria-expanded", "false");
    }
  });
</script>
