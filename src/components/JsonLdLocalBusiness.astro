---
import { SITE } from "../config/site";

const SCHEMA_DAYS = [
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
  "Sunday",
];

const hoursSchema = (SITE.openingHours || [])
  .filter((h) => !h.closed && h.opens && h.closes)
  .map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days.map((d) => SCHEMA_DAYS[d]),
    opens: h.opens,
    closes: h.closes,
  }));

const validSameAs = [
  ...(SITE.business.socialProfiles || []),
  SITE.business.googleBusinessUrl,
].filter(
  (u): u is string =>
    typeof u === "string" &&
    u.trim().length > 0 &&
    !u.includes("example.com") &&
    !u.includes("EXAMPLE")
);

const data: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": SITE.business.schemaType || "Organization",
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  image: new URL(SITE.hero.image, SITE.url).href,
};

if (SITE.business.phone) {
  data.telephone = SITE.business.phone;
}

if (SITE.business.email) {
  data.email = SITE.business.email;
}

if (SITE.business.priceRange) {
  data.priceRange = SITE.business.priceRange;
}

if (SITE.business.address?.city || SITE.business.address?.country) {
  data.address = {
    "@type": "PostalAddress",
    streetAddress: SITE.business.address.street || undefined,
    postalCode: SITE.business.address.postalCode || undefined,
    addressLocality: SITE.business.address.city || undefined,
    addressCountry: SITE.business.address.country || undefined,
  };
}

if (SITE.business.geo?.latitude && SITE.business.geo?.longitude) {
  data.geo = {
    "@type": "GeoCoordinates",
    latitude: SITE.business.geo.latitude,
    longitude: SITE.business.geo.longitude,
  };
}

if (hoursSchema.length > 0) {
  data.openingHoursSpecification = hoursSchema;
}

if (validSameAs.length > 0) {
  data.sameAs = validSameAs;
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
