---
import Base from "../../layouts/Base.astro";
import BrandCard from "../../components/BrandCard.astro";
import { BRANDS } from "../../data/brands";
import { SITE } from "../../config/site";

// SEO ItemList Schema
const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "2026年42家网络加速与专线机场评测品牌库",
  description: "收录42家IEPL/IPLC专线、BGP中转与轻量平价机场，含晚高峰测速图与流媒体AI解锁对比。",
  numberOfItems: BRANDS.length,
  itemListElement: BRANDS.map((b, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: b.name,
    url: `${SITE.url}/brand/${b.slug}/`,
  })),
};
---

<Base
  title="42家机场品牌库大全 — 2026最新测速图、专线对比与优惠码汇总"
  description="全网最全42家机场品牌测评库。收录光速云、暮光加速、飞猫云等主流与新锐品牌，支持按IEPL专线、月付低价、附实测图、AI解锁自由筛选对比。"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />

  <section class="brand-directory-hero">
    <div class="container">
      <div class="directory-hero-content">
        <p class="section-eyebrow">42 BRANDS REVIEWS & BENCHMARKS</p>
        <h1>42 家机场品牌库大全</h1>
        <p class="directory-subtitle">
          收录 42 家国内外网络加速服务商，涵盖企业级 IEPL/IPLC 内网专线、BGP 多线智能中转与平价轻量入门套餐。所有品牌均附带运营年限核验、技术协议、晚高峰表现与流媒体/AI 解锁状态。
        </p>

        <!-- 交互筛选与搜索控制台 -->
        <div class="filter-console">
          <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              id="brand-search-input"
              placeholder="搜索机场名称、协议（VLESS/SS）、线路（IEPL）或优惠码..."
              aria-label="搜索机场品牌"
            />
          </div>

          <div class="filter-pills-row">
            <button class="filter-pill active" data-filter="all">全部品牌 ({BRANDS.length})</button>
            <button class="filter-pill" data-filter="featured">⭐ 全站首推</button>
            <button class="filter-pill" data-filter="speedtest">⚡ 附实测图 (17家)</button>
            <button class="filter-pill" data-filter="专线">🛡️ 专线接入 (IEPL/IPLC)</button>
            <button class="filter-pill" data-filter="低价">💰 平价入门 (5-8元)</button>
            <button class="filter-pill" data-filter="自研客户端">📱 自研客户端</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section brand-grid-section">
    <div class="container">
      <div class="grid-status-bar">
        <div class="count-display">
          展示结果：<strong id="results-count">{BRANDS.length}</strong> / {BRANDS.length} 家机场品牌
        </div>
        <div class="sort-select-wrap">
          <label for="sort-select">排序依据：</label>
          <select id="sort-select">
            <option value="rank">🏆 实验室综合排名</option>
            <option value="price-asc">💵 价格：从低到高</option>
            <option value="name">🔤 品牌首字母 A-Z</option>
          </select>
        </div>
      </div>

      <!-- 品牌卡片网格 -->
      <div class="grid-3" id="brands-grid">
        {BRANDS.map((brand) => (
          <BrandCard brand={brand} featured={brand.isFeatured} />
        ))}
      </div>

      <!-- 空状态提示 -->
      <div id="no-results-box" class="no-results" style="display: none;">
        <span class="no-results-icon">🔎</span>
        <h3>未找到匹配的机场品牌</h3>
        <p>您可以尝试缩短关键词，或清空筛选条件重新查看 42 家完整品牌清单。</p>
        <button id="reset-filter-btn" class="button">恢复全部品牌</button>
      </div>
    </div>
  </section>

  <!-- 选型指引与科普 -->
  <section class="section section-alt">
    <div class="container">
      <h2>机场品牌选购指南与避坑建议</h2>
      <div class="grid-3">
        <div class="card">
          <h3>1. 为什么优先考虑专线 (IEPL/IPLC)？</h3>
          <p class="text-sm text-muted">
            普通公网直连节点经常遭遇国际出口拥塞与 GFW 主动探测阻断。IEPL/IPLC 走陆缆内网点对点直连，物理延迟低、丢包近乎为零，晚高峰依然可以流畅播放 4K 视频。
          </p>
        </div>
        <div class="card">
          <h3>2. 警惕所谓的“超低价无限流量”</h3>
          <p class="text-sm text-muted">
            正规优质专线每 Gbps 带宽月租成本高昂。任何宣称几元钱包月无限量跑满带宽的商家，往往采用严重超售或低质公网中转，极易在敏感时期突发失联。
          </p>
        </div>
        <div class="card">
          <h3>3. 善用优惠码与阶梯周期</h3>
          <p class="text-sm text-muted">
            初次使用建议选择月付或季付，验证晚高峰和自己本地宽带（电信/联通/移动）的契合度。确认稳定后，再使用优惠码（如光速云的 <code>AMM</code>）按年结算获取最大折扣。
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // 客户端实时搜索与多维过滤
  const searchInput = document.getElementById("brand-search-input") as HTMLInputElement;
  const filterPills = document.querySelectorAll(".filter-pill");
  const brandsGrid = document.getElementById("brands-grid");
  const cards = Array.from(document.querySelectorAll(".brand-card")) as HTMLElement[];
  const countDisplay = document.getElementById("results-count");
  const noResultsBox = document.getElementById("no-results-box");
  const resetBtn = document.getElementById("reset-filter-btn");
  const sortSelect = document.getElementById("sort-select") as HTMLSelectElement;

  let activeFilter = "all";
  let searchQuery = "";

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const textContent = card.innerText.toLowerCase();
      const tags = (card.getAttribute("data-tags") || "").toLowerCase();
      const slug = card.getAttribute("data-slug") || "";

      // 文本搜索匹配
      const matchesSearch =
        !searchQuery ||
        textContent.includes(searchQuery) ||
        tags.includes(searchQuery) ||
        slug.includes(searchQuery);

      // 分类筛选匹配
      let matchesFilter = true;
      if (activeFilter === "featured") {
        matchesFilter = card.classList.contains("brand-card-featured");
      } else if (activeFilter === "speedtest") {
        matchesFilter = tags.includes("附实测图");
      } else if (activeFilter === "专线") {
        matchesFilter = tags.includes("专线") || textContent.includes("iepl") || textContent.includes("iplc");
      } else if (activeFilter === "低价") {
        matchesFilter = textContent.includes("5.") || textContent.includes("6.") || textContent.includes("7.") || textContent.includes("8.") || textContent.includes("8元");
      } else if (activeFilter === "自研客户端") {
        matchesFilter = tags.includes("自研客户端") || textContent.includes("自研");
      }

      if (matchesSearch && matchesFilter) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    if (countDisplay) countDisplay.textContent = String(visibleCount);

    if (noResultsBox) {
      noResultsBox.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    applyFilters();
  });

  filterPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      filterPills.forEach((p) => p.classList.remove("active"));
      pill.classList.add("active");
      activeFilter = pill.getAttribute("data-filter") || "all";
      applyFilters();
    });
  });

  resetBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    searchQuery = "";
    activeFilter = "all";
    filterPills.forEach((p) => p.classList.remove("active"));
    filterPills[0]?.classList.add("active");
    applyFilters();
  });
</script>

<style>
  .brand-directory-hero {
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(247, 240, 228, 0.12);
  }

  .directory-hero-content {
    max-width: 860px;
  }

  .directory-hero-content h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    color: #fff;
    margin-bottom: var(--space-2);
  }

  .directory-subtitle {
    font-size: 1.1rem;
    color: var(--color-dark-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .filter-console {
    background: var(--color-dark-surface);
    border: 1px solid rgba(247, 240, 228, 0.15);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-top: var(--space-3);
  }

  .search-input-wrap {
    position: relative;
    margin-bottom: var(--space-2);
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.6;
  }

  #brand-search-input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 42px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    color: #fff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color var(--transition);
  }

  #brand-search-input:focus {
    border-color: var(--color-accent-bright);
    background: rgba(255, 255, 255, 0.12);
  }

  .filter-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-pill {
    background: rgba(255, 255, 255, 0.07);
    color: var(--color-dark-text-muted);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition);
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: var(--color-accent-bright);
    color: var(--color-dark-bg);
    border-color: var(--color-accent-bright);
    font-weight: 700;
  }

  .grid-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .grid-status-bar strong {
    color: var(--color-accent);
  }

  #brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: var(--space-3);
  }

  .sort-select-wrap select {
    padding: 4px 8px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #fff;
    font-size: 0.85rem;
  }

  .no-results {
    text-align: center;
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius);
    border: 1px dashed var(--color-border);
  }

  .no-results-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-2);
  }

  .no-results button {
    margin-top: var(--space-2);
  }
</style>
