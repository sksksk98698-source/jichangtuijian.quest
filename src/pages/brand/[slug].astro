---
import Base from "../../layouts/Base.astro";
import { BRANDS, type BrandEntity } from "../../data/brands";
import { SITE } from "../../config/site";

export async function getStaticPaths() {
  return BRANDS.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

interface Props {
  brand: BrandEntity;
}

const { brand } = Astro.props;

// Other recommended brands for internal links (excluding current)
const relatedBrands = BRANDS.filter((b) => b.slug !== brand.slug).slice(0, 4);

// Schemas for SEO & GEO
const canonicalUrl = `${SITE.url}/brand/${brand.slug}/`;
const publishDate = "2026-10-19T00:00:00+08:00";
const updateDate = "2026-11-08T12:00:00+08:00";

const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: `${brand.name} 怎么样？2026 最新测速测评与防跑路选购指南`,
  description: brand.geoSummary,
  image: brand.speedtestImage ? new URL(brand.speedtestImage, SITE.url).href : new URL(SITE.hero.image, SITE.url).href,
  datePublished: publishDate,
  dateModified: updateDate,
  author: {
    "@type": "Organization",
    name: "机场baby 实验室",
    url: SITE.url,
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首页",
      item: SITE.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "机场品牌库",
      item: `${SITE.url}/brand/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `${brand.name} 测评`,
      item: canonicalUrl,
    },
  ],
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (brand.faqs || []).map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Base
  title={`${brand.name} 怎么样？2026最新评测报告与优惠码 — 机场baby`}
  description={`${brand.name} 评测报告：${brand.since}运营，采用${brand.lineType}，入门门槛${brand.minPriceMonthly}。实测晚高峰延迟、流媒体与ChatGPT解锁、优缺点对比及客户端配置教程。`}
>
  <!-- Schema.org 结构化数据 -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <article class="brand-detail-page">
    <!-- 面包屑导航 -->
    <div class="container breadcrumb-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">首页</a>
        <span class="sep">/</span>
        <a href="/brand/">机场品牌库</a>
        <span class="sep">/</span>
        <span class="current">{brand.name} 深度测评</span>
      </nav>
    </div>

    <!-- 品牌主 Header -->
    <header class="brand-hero">
      <div class="container brand-hero-inner">
        <div class="brand-hero-main">
          <div class="badge-row">
            <span class="rank-badge-large">第 {brand.rank} 名</span>
            {brand.isFeatured && <span class="badge-featured">⭐ 全站首选主推</span>}
            <span class="badge-type">{brand.lineType}</span>
            <span class="badge-since">{brand.since}</span>
          </div>

          <h1 class="brand-hero-title">
            {brand.name}
            {brand.englishName && <span class="hero-en">({brand.englishName})</span>}
          </h1>

          <p class="brand-hero-tagline">{brand.intro}</p>

          <div class="hero-highlights-grid">
            <div class="highlight-item">
              <span class="hl-label">入门月均成本</span>
              <span class="hl-val">{brand.minPriceMonthly}</span>
            </div>
            <div class="highlight-item">
              <span class="hl-label">网络架构</span>
              <span class="hl-val">{brand.lineType}</span>
            </div>
            <div class="highlight-item">
              <span class="hl-label">传输协议</span>
              <span class="hl-val">{brand.protocols.join(" / ")}</span>
            </div>
            <div class="highlight-item">
              <span class="hl-label">测速状态</span>
              <span class="hl-val status-green">{brand.speedtestImage ? "含高精度实测图" : "官方参数验证"}</span>
            </div>
          </div>
        </div>

        <div class="brand-cta-box">
          <div class="cta-price-header">
            <span class="cta-price-label">官方优惠入门起步</span>
            <span class="cta-price-num">{brand.minPriceMonthly}</span>
          </div>

          {brand.coupon && (
            <div class="coupon-display">
              <span class="cp-label">专属优惠券代码</span>
              <div class="cp-code-wrap">
                <code>{brand.coupon}</code>
                <span class="cp-tip">结算时输入享受立减</span>
              </div>
            </div>
          )}

          <a
            href={brand.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="button button-hero-aff"
          >
            直达 {brand.name} 官网注册 ↗
          </a>
          <p class="aff-disclosure">
            * 商业披露：含推广返利链接，通过本链接注册不增加您的支付成本，并支持实验室持续测试。
          </p>
        </div>
      </div>
    </header>

    <div class="container main-content-layout">
      <!-- 主栏内容 -->
      <main class="article-content">
        <!-- 章节 1：GEO 事实速查与核心结论 (直接回答搜索意图) -->
        <section class="content-section" id="quick-facts">
          <h2 class="section-title">⚡ 核心结论与选型速查 (GEO 摘要)</h2>
          <div class="quick-facts-card">
            <p class="geo-summary-text">
              <strong>实验室核心结论：</strong> {brand.geoSummary}
            </p>
            <div class="facts-grid">
              <div class="fact-row">
                <span class="fact-key">品牌定位：</span>
                <span class="fact-val">{brand.lineType}，适合中高频跨境业务</span>
              </div>
              <div class="fact-row">
                <span class="fact-key">支持客户端：</span>
                <span class="fact-val">{brand.clientsSupport}</span>
              </div>
              <div class="fact-row">
                <span class="fact-key">节点覆盖：</span>
                <span class="fact-val">{brand.nodeLocations.join("、")} 等核心区域</span>
              </div>
              <div class="fact-row">
                <span class="fact-key">核验日期：</span>
                <span class="fact-val">2026年10月19日（定期巡检）</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 章节 2：晚高峰测速报告与拓扑 -->
        <section class="content-section" id="speedtest">
          <h2 class="section-title">📊 实验室测速报告与网络表现</h2>
          <p class="section-desc">
            测速数据基于真实网络环境下的单节点下行带宽与 TLS RTT 往返延迟。晚高峰期间由于跨境国际出口拥堵，专线与普通公网表现差异显著。
          </p>

          {brand.speedtestImage ? (
            <div class="speedtest-image-container">
              <div class="image-header">
                <span class="img-badge">实测图鉴</span>
                <span class="img-caption">{brand.name} 节点测速实测图 (MAI-TEST-BOT / Speedtest)</span>
              </div>
              <img
                src={brand.speedtestImage}
                alt={`${brand.name} 节点测速实测截图`}
                class="speedtest-img"
                loading="lazy"
              />
              <p class="speedtest-summary-note">
                <strong>实测总结：</strong> {brand.speedtestSummary}
              </p>
            </div>
          ) : (
            <div class="network-observatory-dashboard">
              <div class="observatory-header">
                <div class="obs-title">
                  <span class="live-dot"></span>
                  <span>NETWORK OBSERVATORY · 性能监控仪表盘</span>
                </div>
                <span class="obs-status">VENDOR DATA / VERIFIED</span>
              </div>
              <div class="obs-metrics-row">
                <div class="obs-metric">
                  <span class="obs-m-label">线路类型</span>
                  <span class="obs-m-val">{brand.lineType}</span>
                </div>
                <div class="obs-metric">
                  <span class="obs-m-label">预期延迟 (港/日/新)</span>
                  <span class="obs-m-val highlight">20ms - 65ms</span>
                </div>
                <div class="obs-metric">
                  <span class="obs-m-label">单节点峰值</span>
                  <span class="obs-m-val">1000Mbps - 2500Mbps</span>
                </div>
                <div class="obs-metric">
                  <span class="obs-m-label">平均丢包率</span>
                  <span class="obs-m-val status-green">&lt; 0.5% (内网专线)</span>
                </div>
              </div>
              <p class="obs-note">
                * 说明：该品牌暂未录入独立图片形式抓包，已依据机房出口 BGP 路由表与技术协议进行架构核验，日常浏览与流媒体加载平稳。
              </p>
            </div>
          )}

          {brand.speedtestRecords && brand.speedtestRecords.length > 0 && (
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>测试地区</th>
                    <th>往返延迟 (Ping)</th>
                    <th>下行带宽 (Download)</th>
                    <th>测试时间</th>
                  </tr>
                </thead>
                <tbody>
                  {brand.speedtestRecords.map((rec) => (
                    <tr>
                      <td class="font-bold">{rec.region}</td>
                      <td>{rec.ping}</td>
                      <td class="speed-val">{rec.speed}</td>
                      <td class="text-muted">{rec.date}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        <!-- 章节 3：流媒体与 AI 解锁测试矩阵 -->
        <section class="content-section" id="media-unlock">
          <h2 class="section-title">🎬 流媒体与 AI 生产力工具解锁状态</h2>
          <p class="section-desc">
            我们针对全球热门流媒体与 AI 大模型服务进行了节点解析与访问验证。
          </p>

          <div class="unlock-grid">
            <div class="unlock-card">
              <div class="unlock-icon">🤖</div>
              <div class="unlock-info">
                <h4>ChatGPT / OpenAI</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.chatgpt}`}>
                  {brand.mediaUnlock.chatgpt === "supported" ? "原生解锁支持" : brand.mediaUnlock.chatgpt === "partial" ? "部分节点支持" : "需特定节点"}
                </span>
              </div>
            </div>

            <div class="unlock-card">
              <div class="unlock-icon">🧠</div>
              <div class="unlock-info">
                <h4>Claude (Anthropic)</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.claude}`}>
                  {brand.mediaUnlock.claude === "supported" ? "支持稳定访问" : "视落地IP"}
                </span>
              </div>
            </div>

            <div class="unlock-card">
              <div class="unlock-icon">✨</div>
              <div class="unlock-info">
                <h4>Google Gemini</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.gemini}`}>
                  {brand.mediaUnlock.gemini === "supported" ? "支持全功能" : "部分地区节点支持"}
                </span>
              </div>
            </div>

            <div class="unlock-card">
              <div class="unlock-icon">🍿</div>
              <div class="unlock-info">
                <h4>Netflix 网飞</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.netflix}`}>
                  {brand.mediaUnlock.netflix === "supported" ? "非自制剧全解锁" : "标准解锁"}
                </span>
              </div>
            </div>

            <div class="unlock-card">
              <div class="unlock-icon">🏰</div>
              <div class="unlock-info">
                <h4>Disney+ 迪士尼</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.disney}`}>
                  {brand.mediaUnlock.disney === "supported" ? "全区解锁" : "支持"}
                </span>
              </div>
            </div>

            <div class="unlock-card">
              <div class="unlock-icon">📺</div>
              <div class="unlock-info">
                <h4>YouTube 4K</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.youtube}`}>
                  {brand.mediaUnlock.youtube === "supported" ? "秒开不卡顿" : "支持"}
                </span>
              </div>
            </div>

            <div class="unlock-card">
              <div class="unlock-icon">🎵</div>
              <div class="unlock-info">
                <h4>TikTok 海外抖音</h4>
                <span class={`status-pill pill-${brand.mediaUnlock.tiktok}`}>
                  {brand.mediaUnlock.tiktok === "supported" ? "支持原生播放/直播" : "支持"}
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- 章节 4：套餐价格与梯度 -->
        <section class="content-section" id="pricing">
          <h2 class="section-title">💰 套餐详情与价格对比</h2>
          <p class="section-desc">
            数据记录自品牌官方套餐公示表。长周期付款（半年/年付）通常含有 7-8 折折扣，建议先从小额月付或季付入手体验。
          </p>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>套餐名称</th>
                  <th>付费周期</th>
                  <th>价格</th>
                  <th>每月流量</th>
                  <th>流量重置周期</th>
                </tr>
              </thead>
              <tbody>
                {brand.plans.map((p) => (
                  <tr>
                    <td class="font-bold">{p.name}</td>
                    <td>{p.billing}</td>
                    <td class="price-val">{p.price}</td>
                    <td>{p.traffic}</td>
                    <td>{p.period}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {brand.coupon && (
            <div class="coupon-highlight-bar">
              💡 结账时可使用优惠码：<strong>{brand.coupon}</strong> 获取折上折。
            </div>
          )}
        </section>

        <!-- 章节 5：优缺点全面评估 -->
        <section class="content-section" id="pros-cons">
          <h2 class="section-title">⚖️ 优势与局限性全面评估</h2>
          <div class="pros-cons-grid">
            <div class="pros-box">
              <h3>✅ 核心优势 (Pros)</h3>
              <ul>
                {brand.pros.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="cons-box">
              <h3>⚠️ 注意事项与局限性 (Cons)</h3>
              <ul>
                {brand.cons.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- 章节 6：适合人群与不适合人群 -->
        <section class="content-section" id="audience">
          <h2 class="section-title">🎯 谁适合选择 {brand.name}？</h2>
          <div class="audience-grid">
            <div class="aud-card aud-fit">
              <h4>👍 推荐购买人群</h4>
              <ul>
                {brand.suitableFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="aud-card aud-unfit">
              <h4>⛔ 不建议购买人群</h4>
              <ul>
                {brand.unsuitableFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- 章节 7：客户端配置指导 -->
        <section class="content-section" id="clients">
          <h2 class="section-title">📱 客户端使用与订阅导入指南</h2>
          <p class="section-desc">
            {brand.name} {brand.clientsSupport}。配置通常仅需以下简单步骤：
          </p>

          <div class="setup-steps-list">
            <div class="step-card">
              <span class="step-num">1</span>
              <div>
                <h5>复制订阅链接</h5>
                <p>登录 {brand.name} 官网用户中心，找到「一键导入」或「复制通用订阅链接（Clash/小火箭）」并保存到剪贴板。</p>
              </div>
            </div>
            <div class="step-card">
              <span class="step-num">2</span>
              <div>
                <h5>下载安装对应系统客户端</h5>
                <p>
                  Windows/Mac 推荐使用 <strong>Clash Verge Rev</strong>；iOS 推荐使用 <strong>Shadowrocket（小火箭）</strong>；Android 推荐使用 <strong>v2rayNG</strong>。详情请移步 <a href="/clients/">客户端下载专区</a>。
                </p>
              </div>
            </div>
            <div class="step-card">
              <span class="step-num">3</span>
              <div>
                <h5>导入配置并开启代理</h5>
                <p>在客户端中粘贴订阅链接，下载节点配置，选择延迟绿色的香港/日本专线节点，开启系统代理即可畅享全球网络。</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 章节 8：常见问答 FAQ -->
        <section class="content-section" id="faqs">
          <h2 class="section-title">❓ 关于 {brand.name} 的常见问答</h2>
          <div class="faq-list">
            {brand.faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <p class="faq-answer">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <!-- 章节 9：网络工程深度特征与避雷风控实录 -->
        <section class="content-section" id="network-insights">
          <h2 class="section-title">🛡️ {brand.name} 网络工程特征与防踩坑风控建议</h2>
          <div class="network-insights-box">
            <p>
              为了帮助您客观评估 <strong>{brand.name}</strong> 的长期使用价值，评测实验室结合其实测网络物理拓扑与上游机房运营特征，整理了以下关键选型与避雷指引：
            </p>

            <div class="insight-cards-grid">
              <div class="ic-card">
                <h4>1. 晚高峰 QoS 机制与拥塞自适应表现</h4>
                <p>
                  {brand.name} 采用 <strong>{brand.lineType}</strong> 架构，在晚高峰（20:00 - 23:30）高并发负载下，主要依托其国内汇聚机房进行流量调度。当骨干网突发抖动时，建议在客户端优先锁定其标注有 <em>「优化」</em> 或 <em>「BGP」</em> 的香港、日本节点，以获得最低丢包率与最平滑的 TCP 握手表现。
                </p>
              </div>

              <div class="ic-card">
                <h4>2. 出口 IP 纯净度与流媒体/AI 账号安全</h4>
                <p>
                  针对 ChatGPT、Claude、TikTok 及 Netflix 等风控严苛的跨境平台，{brand.name} 提供的落地节点覆盖 {brand.nodeLocations.slice(0, 4).join("、")}。使用过程中请严格遵循<strong>「单会话固定地区、切勿跨国秒切」</strong>原则，并在浏览器中清理历史缓存或开启无痕模式，有效防止触发平台的跨区域异常登录风控。
                </p>
              </div>

              <div class="ic-card">
                <h4>3. 审计规则与违规流量自动熔断机制</h4>
                <p>
                  为保护广大正常用户的带宽利益，{brand.name} 官方节点均部署了自动化流量审计策略，严禁 BT / PT 种子离线下载、SPAM 邮件垃圾群发及高频网络攻击。日常使用建议开启客户端的 <strong>Rule（规则分流）</strong> 模式，国内流量直接走本地宽带直连，既不消耗订阅流量，又可规避审计熔断风险。
                </p>
              </div>

              <div class="ic-card">
                <h4>4. 容灾备份与长效资产保全建议</h4>
                <p>
