---
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";
import Hero from "../components/sections/Hero.astro";
import FeaturedAirport from "../components/sections/FeaturedAirport.astro";
import SpeedtestGallery from "../components/sections/SpeedtestGallery.astro";
import Services from "../components/sections/Services.astro";
import About from "../components/sections/About.astro";
import CtaBanner from "../components/sections/CtaBanner.astro";
import Faq from "../components/sections/Faq.astro";
import PracticalInfo from "../components/sections/PracticalInfo.astro";
import Contact from "../components/sections/Contact.astro";
---

<Base title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} withJsonLd>
  <Hero />
  <FeaturedAirport />
  <SpeedtestGallery />
  <Services />
  <About />
  <CtaBanner />
  <Faq />
  <PracticalInfo />
  <Contact />
</Base>
